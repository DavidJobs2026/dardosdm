DATABASE_URL="postgresql://user:password@localhost:5432/tournament_db"
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
CLIENT_URL="http://localhost:3000"
PORT=4000
NODE_ENV=development

# Email — Resend (https://resend.com)
# Create an API key with "Sending access" and verify your domain first
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="DardosDM <noreply@yourdomain.com>"

# Daily backup (03:00 Europe/Madrid) — emailed as an AES-256 encrypted attachment.
# BACKUP_PASSPHRASE is REQUIRED: without it the backup is NOT sent (fail-secure,
# the export contains PII). Store the passphrase somewhere safe — without it the
# backup files cannot be recovered. Decrypt with:
#   openssl enc -d -aes-256-cbc -pbkdf2 -in backup.json.enc -out backup.json
BACKUP_EMAIL="admin@yourdomain.com"
BACKUP_PASSPHRASE="a-long-random-passphrase-keep-it-safe"
